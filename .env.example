# LiveVoice AI - Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# AI Engine Configuration
# Options: 'local_edge' (Default Microsoft Edge Neural TTS + Local ASR), 'openai', 'mock_test'
AI_PROVIDER=local_edge
OPENAI_API_KEY=

# Local Mode
LOCAL_ONLY_MODE=false

# Default Languages
DEFAULT_SOURCE_LANG=te
DEFAULT_TARGET_LANG=en

# Audio VAD Settings
AUDIO_SAMPLE_RATE=16000
VAD_SILENCE_THRESHOLD_MS=650
VAD_ENERGY_THRESHOLD=250

# Security & Concurrency
SESSION_TIMEOUT_MINUTES=60
MAX_CONCURRENT_SESSIONS=30
PERSIST_AUDIO_BY_DEFAULT=false
